GUIDE_APP_NAME=AI Scenic Guide API
GUIDE_SERVICE_NAME=ai-scenic-guide-api
GUIDE_VERSION=0.1.0
GUIDE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# mock: use local data/mock/faq.json; dify: call Dify Chat App API
GUIDE_ANSWER_PROVIDER=mock
GUIDE_DIFY_API_BASE_URL=https://api.dify.ai/v1
GUIDE_DIFY_API_KEY=replace-with-your-dify-app-api-key
GUIDE_DIFY_TIMEOUT_SECONDS=30

# disabled: keep lightweight browser avatar; sadtalker: generate talking-head mp4 through local SadTalker
GUIDE_AVATAR_PROVIDER=disabled
GUIDE_AVATAR_ASSETS_PATH=D:\ai-scenic-guide\data\avatar
GUIDE_GENERATED_ASSETS_PATH=D:\ai-scenic-guide\data\generated
GUIDE_SADTALKER_ROOT=D:\ai-scenic-guide-engines\SadTalker
GUIDE_SADTALKER_PYTHON=D:\ai-scenic-guide-engines\SadTalker\.venv\Scripts\python.exe
GUIDE_SADTALKER_SOURCE_IMAGE=D:\ai-scenic-guide\data\avatar\huangshan-guide.png
GUIDE_SADTALKER_TIMEOUT_SECONDS=900
GUIDE_SADTALKER_PREPROCESS=full
GUIDE_SADTALKER_EXPRESSION_SCALE=1.6
GUIDE_SADTALKER_STILL=true
GUIDE_SADTALKER_USE_CPU=false
